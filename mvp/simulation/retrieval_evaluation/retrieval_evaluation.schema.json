{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agribrain.example/schemas/independent-retrieval-evaluation-v1.json",
  "title": "AGRI-BRAIN independent retrieval-ranking evaluation metadata",
  "description": "Metadata for a fixed-query, pooled, blinded human comparison of Standard RAG and piR. Cross-file constraints listed in x-cross-file-rules are enforced by validate_retrieval_evaluation.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "evidence_scope",
    "downstream_ari_in_scope",
    "comparison",
    "systems",
    "study_design",
    "assessment",
    "analysis",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "agribrain-independent-retrieval-evaluation-v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_scope": {
      "const": "retrieval_ranking_quality_only"
    },
    "downstream_ari_in_scope": {
      "const": false
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_system_id",
        "control_retrieval_label",
        "candidate_system_id",
        "candidate_retrieval_label",
        "contrast_direction"
      ],
      "properties": {
        "control_system_id": {"const": "agribrain_standard_rag"},
        "control_retrieval_label": {"const": "Standard RAG"},
        "candidate_system_id": {"const": "agribrain"},
        "candidate_retrieval_label": {"const": "piR"},
        "contrast_direction": {"const": "piR_minus_Standard_RAG"}
      }
    },
    "systems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_id",
          "retrieval_variant",
          "run_id",
          "code_revision",
          "configuration_sha256"
        ],
        "properties": {
          "system_id": {
            "enum": ["agribrain_standard_rag", "agribrain"]
          },
          "retrieval_variant": {
            "enum": ["standard_rag", "pirag"]
          },
          "run_id": {"type": "string", "minLength": 1},
          "code_revision": {"type": "string", "minLength": 1},
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "study_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_set_fixed_before_judgment",
        "document_pool_fixed_before_judgment",
        "runs_frozen_before_judgment",
        "pooled_documents_deduplicated",
        "system_labels_masked",
        "presentation_order_randomized",
        "run_depth"
      ],
      "properties": {
        "query_set_fixed_before_judgment": {"const": true},
        "document_pool_fixed_before_judgment": {"const": true},
        "runs_frozen_before_judgment": {"const": true},
        "pooled_documents_deduplicated": {"const": true},
        "system_labels_masked": {"const": true},
        "presentation_order_randomized": {"const": true},
        "run_depth": {"type": "integer", "minimum": 1}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judgment_source",
        "assessor_cohort_id",
        "assessor_count",
        "assessor_ids_are_pseudonymous",
        "independent_of_system_development",
        "independence_basis",
        "blinded_to_system_identity",
        "blinding_protocol",
        "judgment_scale",
        "provenance_record_id"
      ],
      "properties": {
        "judgment_source": {"const": "independent_human"},
        "assessor_cohort_id": {"type": "string", "minLength": 1},
        "assessor_count": {"type": "integer", "minimum": 1},
        "assessor_ids_are_pseudonymous": {"const": true},
        "independent_of_system_development": {"const": true},
        "independence_basis": {"type": "string", "minLength": 1},
        "blinded_to_system_identity": {"const": true},
        "blinding_protocol": {"type": "string", "minLength": 1},
        "judgment_scale": {"enum": ["binary_0_1", "ordinal_0_2"]},
        "provenance_record_id": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoffs",
        "primary_metric",
        "primary_cutoff",
        "query_aggregation",
        "bootstrap_confidence_level",
        "bootstrap_resamples",
        "bootstrap_seed"
      ],
      "properties": {
        "cutoffs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "primary_metric": {"const": "ndcg"},
        "primary_cutoff": {"type": "integer", "minimum": 1},
        "query_aggregation": {"const": "mean_assessor_metric_then_mean_query"},
        "bootstrap_confidence_level": {
          "type": "number",
          "minimum": 0.8,
          "exclusiveMaximum": 1.0
        },
        "bootstrap_resamples": {"type": "integer", "minimum": 1000},
        "bootstrap_seed": {"type": "integer", "minimum": 0}
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_set",
        "document_catalog",
        "retrieval_runs",
        "assessors",
        "relevance_judgments"
      ],
      "properties": {
        "query_set": {"$ref": "#/$defs/sha256"},
        "document_catalog": {"$ref": "#/$defs/sha256"},
        "retrieval_runs": {"$ref": "#/$defs/sha256"},
        "assessors": {"$ref": "#/$defs/sha256"},
        "relevance_judgments": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "x-csv-files": {
    "query_set.csv": ["query_id", "query_text", "query_text_sha256", "query_stratum", "source_record_id"],
    "document_catalog.csv": ["doc_id", "content_sha256", "source_record_id", "descriptor"],
    "retrieval_runs.csv": ["query_id", "system_id", "rank", "doc_id", "score", "run_record_id"],
    "assessors.csv": ["assessor_id", "expertise_category", "independent_of_system_development", "blinded_to_system_identity", "provenance_record_id", "judgment_completed_at_utc"],
    "relevance_judgments.csv": ["query_id", "doc_id", "assessor_id", "relevance", "judgment_record_id"]
  },
  "x-cross-file-rules": [
    "Every query_id and doc_id must be fixed by the declared file SHA-256 values.",
    "Each query must have exactly run_depth ranked documents for each of the two systems, with consecutive ranks and no duplicate document within a run.",
    "Every document retrieved by either system must have one explicit judgment from every declared assessor; unjudged documents are never treated as nonrelevant.",
    "Every assessor must separately attest independence from system development and blinding to system identity.",
    "Binary judgments are integers 0 or 1; ordinal judgments are integers 0, 1, or 2.",
    "The five input file hashes must match byte-for-byte before analysis."
  ]
}
