# Versioning policy: the pinned ``version`` here must match
# ``[project] version`` in agribrain/backend/pyproject.toml. The
# tests/test_metadata_consistency.py guard fails the build if they
# drift. Add ``date-released`` only when the corresponding v<X.Y.Z>
# tag is actually pushed; this methodology-aligned source is pre-results.
#
# After a fresh validated run exists, cite the version + source commit SHA
# from its `artifact_manifest.json` for paper-grade reproducibility.
license: MIT
repository-code: "https://github.com/kprodigi/AGRI-BRAIN"

# DOI deliberately omitted from this file. Cite via version + commit
# SHA + repository URL. If a Zenodo DOI is minted in a later release
# cycle, add the canonical ``identifiers:`` block (CFF 1.2 schema)
# rather than re-introducing a top-level ``doi:`` field.
