# Raw per-seed decision ledgers remain runtime/archive-only inputs.
mvp/simulation/results/decision_ledger_per_seed/
# The 500 retained H3 stressed-arm ledgers are likewise runtime/archive-only;
# the publication manifest includes the exact run-tagged tree and its literal
# hashes when ARTIFACT_MANIFEST_INCLUDE_RAW=1.
mvp/simulation/results/decision_ledger_h3/
# Prospective allowlist for validated channel-attribution outputs. These files
# are not present in a fresh source clone until a new run passes publication.
!mvp/simulation/results/channel_attribution_aggregate.json
!mvp/simulation/results/channel_complementarity_test.json
# Prospective allowlist for the validated channel-saturation analysis.
!mvp/simulation/results/channel_saturation_analysis.json

# Raw per-decision ledgers the HPC seed array writes into each tagged seed dir
# (benchmark_seeds/<RUN_TAG>/decision_ledger_<seed>/): 300 MB+ of regenerable
# channel-aggregator inputs, archived in the hpc_results tarball, not committed.
# Seed envelopes are included only in a fresh run's checksummed evidence asset.
mvp/simulation/results/benchmark_seeds/*/decision_ledger_*/

# Manuscript-production tooling and raw traces kept beside the repository.
# These are working files for preparing the paper, not part of the released
# research artifact, and nothing in the repository references them.
/scripts/
/tools/
/preserved_seed_*.json
