__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Working scratch files at repo root (audit-pass tmp scripts, draft
# manuscript snapshots, sanity-check probes). Strict pattern at the
# repo root so a stray `git add -A` cannot leak a draft manuscript or
# diagnostic script into the GitHub history. The user's working
# .tmp_paper.md draft is matched here too.
/.tmp_*
# Root-anchored manuscript guard: plain-named drafts (e.g.
# AGRI-BRAIN_Final_v12.docx, AGRI-BRAIN_main_revised.md) are not
# caught by /.tmp_*, and one was accidentally committed once. No
# tracked root file matches these patterns, so they are safe.
/*.docx
/*.pdf
/AGRI-BRAIN_*
/FOCAPO-*

# HPC pipeline outputs. The slurm orchestrator writes per-job stdout
# / stderr into ``logs/`` and the aggregator's last step produces
# ``hpc_results_<RUN_TAG>.tar.gz`` at the repo root. Both are
# transient run artefacts that should not enter the GitHub history;
# keeping them gitignored keeps the dirty-tree check in
# build_artifact_manifest.py focused on actual uncommitted code
# changes rather than expected run output.
/logs/
/hpc_results_*.tar.gz

# Stochastic feasibility test scripts (diagnostic, not production)
docs/screenshots/_check/
node_modules/
dist/
.venv/
*.egg-info/

# IDE / editor
.vscode/
.idea/
.vite/

# Hardhat build artifacts
**/hardhat/artifacts/
**/hardhat/cache/
# Stale top-level Hardhat build dir (pre-2026-05). Removed from the
# tree because the canonical Hardhat artifacts location is
# agribrain/contracts/hardhat/artifacts/ (covered by the rule above).
# Listed here so a future ``npx hardhat compile`` from the wrong cwd
# cannot resurrect the duplicate.
agribrain/build/

# Environment and secrets
.env
.env.local
.env.production
.envrc

# Cryptographic keys and credentials — broad patterns so an operator
# cloning the repo and running an on-chain experiment cannot
# accidentally `git add -A` a private keypair or token file.
*.pem
*.key
*.keystore
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.gpg
*.kdbx
secrets.json
secrets.yaml
credentials.json
service-account*.json

# HPC artifacts (the hpc_*.sh scripts are tracked)
hpc_import.sh
hpc_results.tar.gz
hpc_results_*.tar.gz
agribrain-repro-*.out
agribrain-repro-*.err
logs/

# Experiment run outputs (regenerated by backend/experiments/run_experiments.py)
agribrain/backend/experiments/out/

# PiRAG vector store persistence
*.vectorstore
pirag_vectors/

# Simulation results: keep canonical tables + figures, ignore volatile runtime outputs
mvp/simulation/results/*
!mvp/simulation/results/table1_summary.csv
!mvp/simulation/results/table2_ablation.csv
!mvp/simulation/results/benchmark_summary.json
!mvp/simulation/results/benchmark_significance.json
!mvp/simulation/results/stress_summary.json
!mvp/simulation/results/stress_degradation.csv
!mvp/simulation/results/feature_heatmap_data.json
!mvp/simulation/results/artifact_manifest.json
!mvp/simulation/results/fig*.png
!mvp/simulation/results/fig*.pdf
# FOCAPO conference results figures (separate folder, rendered on HPC)
!mvp/simulation/results/focapo/
!mvp/simulation/results/focapo/*.png
# 2026-05 manuscript figure renames (commits c06bc26 + b73a084):
# old fig2_heatwave -> heatwave, fig3_overproduction -> overproduction, etc.
!mvp/simulation/results/heatwave.png
!mvp/simulation/results/heatwave.pdf
!mvp/simulation/results/overproduction.png
!mvp/simulation/results/overproduction.pdf
!mvp/simulation/results/cyber_outage.png
!mvp/simulation/results/cyber_outage.pdf
!mvp/simulation/results/adaptive_pricing.png
!mvp/simulation/results/adaptive_pricing.pdf
!mvp/simulation/results/cross_scenario.png
!mvp/simulation/results/cross_scenario.pdf
!mvp/simulation/results/ablation.png
!mvp/simulation/results/ablation.pdf
!mvp/simulation/results/green_ai_carbon.png
!mvp/simulation/results/green_ai_carbon.pdf
# 2026-06 H1/H2/H3 paper figures (generate_figures.py fig11/fig12/fig13):
# performance_efficiency (H1), context_value (H2), stress_robustness (H3).
!mvp/simulation/results/context_value.png
!mvp/simulation/results/context_value.pdf
!mvp/simulation/results/performance_efficiency.png
!mvp/simulation/results/performance_efficiency.pdf
!mvp/simulation/results/stress_robustness.png
!mvp/simulation/results/stress_robustness.pdf
# Paper-evidence artefacts produced by hpc_aggregate.sh stages 4, 6, 8.
# These files are the canonical evidence for cross-method ranking,
# stress robustness, and within-trace temporal stability. Pre-2026-05
# they were in the manifest
# but not the gitignore allowlist, so they only existed in the HPC
# tar.gz archive and a reviewer cloning the repo could not verify the
# claims without first downloading the archive.
!mvp/simulation/results/paper_benchmark_table.json
!mvp/simulation/results/stress_passfail.csv
!mvp/simulation/results/temporal_stability_summary.json
!mvp/simulation/results/temporal_stability_summary.csv
!mvp/simulation/results/temporal_stability_deltas.csv
# 2026-05 Path A: per-seed scalar envelopes (~2.7 MB x 20 seeds per
# run snapshot; ~206 MB total across the committed RUN_TAG snapshots)
# committed so a fresh clone can re-run the BCa bootstrap on
# benchmark_summary.json without re-running the 50-h HPC benchmark.
# See mvp/simulation/results/benchmark_seeds/README.md for which
# snapshot is canonical.
!mvp/simulation/results/benchmark_seeds/
!mvp/simulation/results/benchmark_seeds/**
# The raw per-seed decision ledgers behind the channel-attribution
# aggregate are intentionally NOT committed: they reached ~330 MB /
# 1900 files, far beyond their reproducibility value. The aggregate
# they feed (channel_attribution_aggregate.json, allowlisted below)
# carries the published numbers; regenerate the raw ledgers with
# hpc/hpc_aggregate.sh (or mvp/simulation/_run_h2_all.py) then
# aggregate_channel_attribution.py.
mvp/simulation/results/decision_ledger_per_seed/
# 2026-06 §5.8 decision-level channel attribution (replaces the logit-shift
# view above). channel_attribution_aggregate.json is fetched live by the
# frontend H2 panel and consumed by the paper Fig 14 generator, so it must be
# in a fresh clone. The raw instrumented per-seed ledgers it is derived from
# (decision_ledger_h2/, ~180 MB) stay ignored as volatile runtime output —
# reproduce them with mvp/simulation/_run_h2_all.py then
# aggregate_channel_attribution.py (PYTHONHASHSEED=0, deterministic).
!mvp/simulation/results/channel_attribution_aggregate.json
!mvp/simulation/results/channel_complementarity_test.json
!mvp/simulation/results/channel_hashseed_stability.json
# 2026-06 C4 disambiguation: TOST equivalence + cross-fit moderation on the
# add-second-channel contrasts (channel_saturation_analysis.py over the
# canonical benchmark_seeds run). Committed so a fresh clone can read the
# saturation/redundancy verdicts (§5.8 channel analysis) without re-running.
!mvp/simulation/results/channel_saturation_analysis.json
# 2026-06 §5.8 specification-curve / multiverse robustness (channel_spec_curve.py
# over decision_ledger_h2). Committed so a fresh clone can verify the headline
# conclusions are invariant to the analysis's discretionary choices.
!mvp/simulation/results/channel_spec_curve.json
# 2026-06 #1b over-steering ablation (run_over_steer_ablation.py): the
# aggregated result AND the per-(scenario,seed) raw checkpoint cells, committed
# so an HPC/local rerun can --resume from saved cells or --aggregate-only
# without recomputing. Cells are small (40 x ~0.3 KB).
!mvp/simulation/results/over_steer_ablation.json
!mvp/simulation/results/over_steer_cells/
!mvp/simulation/results/over_steer_cells/**

# Raw per-decision ledgers the HPC seed array writes into each tagged seed dir
# (benchmark_seeds/<RUN_TAG>/decision_ledger_<seed>/): 300 MB+ of regenerable
# channel-aggregator inputs, archived in the hpc_results tarball, not committed.
# The small per-seed seed_*.json scalar envelopes stay tracked.
mvp/simulation/results/benchmark_seeds/*/decision_ledger_*/
