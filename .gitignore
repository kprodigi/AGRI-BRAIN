__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Operating-system and generic local logs
.DS_Store
Thumbs.db
Desktop.ini
*.log

# Working scratch files at repo root (audit-pass tmp scripts, draft
# manuscript snapshots, sanity-check probes). Strict pattern at the
# repo root so a stray `git add -A` cannot leak a draft manuscript or
# diagnostic script into the GitHub history. The user's working
# .tmp_paper.md draft is matched here too.
/.tmp_*
# Root-anchored manuscript guard: plain-named drafts (e.g.
# AGRI-BRAIN_Final_v12.docx, AGRI-BRAIN_main_revised.md) are not
# caught by /.tmp_*, and one was accidentally committed once. No
# tracked root file matches these patterns, so they are safe.
/*.docx
/*.pdf
/AGRI-BRAIN_*
/FOCAPO-*

# HPC pipeline outputs. The slurm orchestrator writes per-job stdout
# / stderr into ``logs/`` and the aggregator's last step produces
# ``hpc_results_<RUN_TAG>.tar.gz`` at the repo root. Both are
# transient run artefacts that should not enter the GitHub history;
# keeping them gitignored keeps the dirty-tree check in
# build_artifact_manifest.py focused on actual uncommitted code
# changes rather than expected run output.
/logs/
/hpc_results_*.tar.gz
# The publication aggregator moves superseded, tracked diagnostics here before
# manifest construction. Their deletions under results/ are intentionally
# ignored by the manifest dirty-tree filter; this run-output directory must be
# ignored as well so preserving those files cannot make a clean commit appear
# to contain uncommitted source changes.
/hpc_legacy_results/
/publication_bundle_*/

# Stochastic feasibility test scripts (diagnostic, not production)
docs/screenshots/_check/
node_modules/
dist/
.venv/
/.publication_venvs/
/.publication_sources/
*.egg-info/

# IDE / editor
.vscode/
.idea/
.vite/

# Hardhat build artifacts
**/hardhat/artifacts/
**/hardhat/cache/
# Stale top-level Hardhat build dir (pre-2026-05). Removed from the
# tree because the canonical Hardhat artifacts location is
# agribrain/contracts/hardhat/artifacts/ (covered by the rule above).
# Listed here so a future ``npx hardhat compile`` from the wrong cwd
# cannot resurrect the duplicate.
agribrain/build/

# Environment and secrets
.env
.env.local
.env.production
.envrc

# Cryptographic keys and credentials — broad patterns so an operator
# cloning the repo and running an on-chain experiment cannot
# accidentally `git add -A` a private keypair or token file.
*.pem
*.key
*.keystore
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.gpg
*.kdbx
secrets.json
secrets.yaml
credentials.json
service-account*.json

# HPC artifacts (the hpc_*.sh scripts are tracked)
hpc_import.sh
hpc_results.tar.gz
hpc_results_*.tar.gz
agribrain-repro-*.out
agribrain-repro-*.err
logs/

# Experiment run outputs (regenerated by backend/experiments/run_experiments.py)
agribrain/backend/experiments/out/

# PiR vector store persistence
*.vectorstore
pirag_vectors/

# Simulation results: keep canonical tables + figures, ignore volatile runtime outputs
mvp/simulation/development_results/
mvp/simulation/results/*
!mvp/simulation/results/README.md
!mvp/simulation/results/table1_summary.csv
!mvp/simulation/results/table2_ablation.csv
!mvp/simulation/results/benchmark_summary.json
!mvp/simulation/results/benchmark_significance.json
!mvp/simulation/results/h2_directional_evidence.csv
!mvp/simulation/results/secondary_ablation_analysis.json
!mvp/simulation/results/secondary_ablation_analysis.csv
!mvp/simulation/results/stress_summary.json
!mvp/simulation/results/stress_degradation.csv
!mvp/simulation/results/artifact_manifest.json
!mvp/simulation/results/publication_validation_receipt.json
!mvp/simulation/results/figure_provenance.json
# Small canonical authorization documents needed to validate a public
# dual-provenance manifest. Raw episode outputs remain ignored/archive-only.
!mvp/simulation/results/publication_recovery_receipts/
mvp/simulation/results/publication_recovery_receipts/*
!mvp/simulation/results/publication_recovery_receipts/*.json
!mvp/simulation/results/preserved_raw_manifests/
mvp/simulation/results/preserved_raw_manifests/*
!mvp/simulation/results/preserved_raw_manifests/*.json
!mvp/simulation/results/core_submission_receipts/
mvp/simulation/results/core_submission_receipts/*
!mvp/simulation/results/core_submission_receipts/*.json
# Rendered figures are not committed. The manuscript prints a
# presentation-only re-render of the certified numbers, and the renderer
# in this tree reproduces that set, so committing the publication run's
# own images would ship figures this code no longer produces. The images
# stay in the evidence deposit, hashed by artifact_manifest.json.
# FOCAPO conference results figures (separate folder, rendered on HPC)
!mvp/simulation/results/focapo/
!mvp/simulation/results/focapo/*.png
# Canonical paper-evidence artifacts produced by the publication pipeline.
!mvp/simulation/results/paper_benchmark_table.json
!mvp/simulation/results/stress_passfail.csv
!mvp/simulation/results/stress_h3_test.json
!mvp/simulation/results/explainability_metrics.json
!mvp/simulation/results/forecast_validation_summary.json
!mvp/simulation/results/forecast_validation_predictions.csv
# Keep the benchmark-seed subtree ignored by default.  Only the exact 20 flat
# canonical envelopes may be tracked; run-tagged copies, auxiliary outputs,
# partial checkpoints, and ledgers remain archive-only evidence.
!mvp/simulation/results/benchmark_seeds/
mvp/simulation/results/benchmark_seeds/**
!mvp/simulation/results/benchmark_seeds/seed_7.json
!mvp/simulation/results/benchmark_seeds/seed_42.json
!mvp/simulation/results/benchmark_seeds/seed_99.json
