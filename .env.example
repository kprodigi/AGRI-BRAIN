# =========================================================================
# WARNING: These are DEVELOPMENT defaults. For production, set at minimum:
#   APP_ENV=prod
#   REQUIRE_API_KEY=true
#   APP_API_KEY=<strong-random-key>
#   CORS_ORIGINS=https://your-domain.com
#   ENABLE_DEBUG_ROUTES=false
#   WS_REQUIRE_API_KEY=true
#   WS_API_KEY=<strong-random-key>
# Additional production hardening:
#   - Do NOT send CHAIN_PRIVKEY via POST /chain/config in a shared proxy
#     environment; set it via env so it never enters an HTTP request body.
#   - Terminate TLS in front of the API; the FastAPI server is not TLS.
#   - Restrict CORS_ORIGINS to your known frontend origin(s).
#   - Disable the demo /admin debug routes by setting ENABLE_DEBUG_ROUTES=false.
# =========================================================================
APP_ENV=dev
CORS_ORIGINS=*
REQUIRE_API_KEY=false
APP_API_KEY=
ALLOW_LOCAL_WITHOUT_API_KEY=true
ENABLE_DEBUG_ROUTES=true
WS_REQUIRE_API_KEY=false
WS_API_KEY=
# Gate Swagger/ReDoc/openapi.json behind the API key. Defaults to false
# in dev so the docs UI is reachable without a key during local work.
# Set to true in production (and the .env.prod.example default is true)
# so the route schema is not enumerable by anonymous clients.
PROTECT_DOCS=false
# Optional scoped API keys. When unset, the corresponding scope falls
# back to APP_API_KEY -- so single-key deployments keep working unchanged.
# Setting any of these introduces a per-scope key that the matching
# router enforces via require_scope_api_key (governance / chain / phase /
# mcp). Use scoped keys to limit blast radius: e.g. distribute the
# governance key only to admin tooling, the chain key only to deploy
# pipelines, etc.
GOVERNANCE_API_KEY=
CHAIN_API_KEY=
PHASE_API_KEY=
MCP_API_KEY=
CHAIN_REQUIRE_PRIVKEY=true
# Signing key used by the Python on-chain client when POST /chain/config has
# not been called with an explicit private_key. Loaded via env as a fallback
# only; the HTTP /chain/config endpoint redacts the key to a presence flag
# ("set" / "unset") in its response so keys never cross proxy boundaries.
# Leave empty when not anchoring on-chain.
CHAIN_PRIVKEY=
# HTTP RPC endpoint for on-chain calls. Example: http://127.0.0.1:8545 for
# a local Hardhat node. Leave empty to disable on-chain submission.
CHAIN_RPC=
# Deployed DecisionLogger address. Populated automatically when the Hardhat
# deploy script writes backend/runtime/chain/deployed-addresses.*.json and
# auto-loading is enabled.
CHAIN_DECISION_LOGGER=

# Validation-selected confirmatory defaults. LSTM demand and Holt-linear
# supply remain diagnostic candidates only.
FORECAST_METHOD=holt_linear
SUPPLY_FORECAST_METHOD=persistence
# Gates only the legacy auxiliary PolicyLearner. The benchmark's
# ContextMatrixLearner, PolicyDeltaLearner, and RewardShapingLearner are
# controlled by the mode/episode design and remain active where declared.
ONLINE_LEARNING=false
LLM_PROVIDER=template
DATA_CSV=
# Internal simulation API base URL. Leave empty (default) for local
# development and HPC runs — the simulator runs as a Python subprocess
# that does not expose a REST endpoint, and the MCP `simulate` tool is
# intentionally not registered when SIM_API_BASE is empty (see
# pirag/mcp/registry.py). Set to http://127.0.0.1:8100 only when you
# have a separate FastAPI simulator process running on that port and
# want MCP-routed forward simulations to reach it.
SIM_API_BASE=
RAG_CONTEXT_ENABLED=true

# Frontend build-time API base (read by Vite via import.meta.env.VITE_API_BASE).
# Leave unset for local dev — the frontend falls back to
# window.API_BASE > localStorage.API_BASE > http://127.0.0.1:8100. Set this
# when building a production bundle that should ship hard-coded against a
# specific backend host. See agribrain/frontend/src/mvp/api.js for the
# resolution order.
# VITE_API_BASE=

# Development stochastic defaults: seven active source groups plus a
# telemetry-lag channel. Optional policy-temperature heterogeneity is exposed
# separately and fixed at zero in the confirmatory benchmark. These are
# declared synthetic calibration values, not estimates of field distributions.
# Publication jobs do not rely on this file: hpc/publication_env.sh pins and
# hpc/validate_publication_env.py validates the canonical run environment.
DETERMINISTIC_MODE=false
# Source group 1: sensor noise
STOCH_TEMP_STD_C=2.5
STOCH_RH_STD=7.0
# Source group 2: demand variability
STOCH_DEMAND_FRAC_STD=0.25
# Source group 3: inventory/yield uncertainty
STOCH_INVENTORY_FRAC_STD=0.22
# Source group 4: transport distance jitter
STOCH_TRANSPORT_KM_STD=0.22
# Source group 5: spoilage-parameter uncertainty
STOCH_K_REF_STD=0.20
STOCH_EA_R_STD=0.14
# Source group 6: scenario-onset timing jitter
STOCH_ONSET_JITTER_H=6.0
# Source group 7: policy-weight perturbation
STOCH_THETA_NOISE_STD=0.15
# Optional policy-temperature heterogeneity (disabled for confirmation)
STOCH_POLICY_TEMP_STD=0.0
# Telemetry lag: intermittent carry-forward of the previous sample
STOCH_DELAY_PROB=0.10

# Experiment toggles
MCP_QOS_ROUTING=false
MCP_RELIABILITY=false
PIR_COUNTERFACTUAL=false
PHYSICS_CONSISTENCY_GATE=false
HETEROGENEOUS_PROFILES=false
RESEARCH_METRICS=false
FAILURE_INJECTION=false
BENCHMARK_SEEDS=42,1337,2024,7,99,101,202,303,404,505,606,707,808,909,1010,1111,1212,1313,1414,1515

# Reproducibility provenance (HPC pipeline-set; see HOW_TO_RUN.md "Reproducibility provenance")
# RUN_TAG: HPC run identifier in the form <commit>_<YYYYMMDD>_<HHMMSS>. Exported by hpc/hpc_run.sh.
#RUN_TAG=
# DECISION_LEDGER_DIR: Per-seed JSONL destination. Each episode uses a fresh in-memory
# ledger for chain_query. Repeated learning episodes overwrite the arm filename, so the
# publication archive retains the final episode for each scenario-mode-seed arm. The seed
# script assigns a separate directory to every Slurm task to prevent cross-seed overwrites.
#DECISION_LEDGER_DIR=mvp/simulation/results/decision_ledger/
# AGRIBRAIN_GIT_COMMIT: Override stamped into artifact_manifest.json and paper_benchmark_table.json
# _meta.git_commit. The HPC pipeline exports this on the login node so the slurm worker still
# records the correct commit even when git is not in PATH.
#AGRIBRAIN_GIT_COMMIT=
# AGRIBRAIN_ALLOW_DIRTY: When 1, build_artifact_manifest.py accepts a dirty working tree and
# appends "+dirty" to the recorded commit. Default 0 rejects dirty trees so published artifacts
# cannot silently claim "matches commit X" while modulo-uncommitted-changes.
#AGRIBRAIN_ALLOW_DIRTY=0

# Blockchain runtime (read by the backend chain bridge at src/chain/eth.py + src/chain/contracts.py)
# CHAIN_PRIVKEY: EVM private key (no 0x prefix needed) used to sign on-chain transactions for the
# DAO governance flow. Surfaced into in-process CHAIN["private_key"] on every _try_autoload call
# in src/routers/governance.py. /governance/contracts/dao/* return ok=false (silent no-op) when unset.
#CHAIN_PRIVKEY=
# CHAIN_RPC: EVM JSON-RPC endpoint. Default 127.0.0.1:8545 targets a local Hardhat node. For
# testnet (Sepolia / Polygon Amoy / Base Sepolia) point at the provider URL.
#CHAIN_RPC=http://127.0.0.1:8545
